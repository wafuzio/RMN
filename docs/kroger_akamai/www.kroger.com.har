\"},{\"perspective\":\"bottom\",\"url\":\"https://www.kroger.com/product/images/large/bottom/0002531700590\",\"size\":\"large\"},{\"perspective\":\"bottom\",\"url\":\"https://www.kroger.com/product/images/medium/bottom/0002531700590\",\"size\":\"medium\"},{\"perspective\":\"bottom\",\"url\":\"https://www.kroger.com/product/images/small/bottom/0002531700590\",\"size\":\"small\"},{\"perspective\":\"bottom\",\"url\":\"https://www.kroger.com/product/images/thumbnail/bottom/0002531700590\",\"size\":\"thumbnail\"},{\"perspective\":\"left\",\"url\":\"https://www.kroger.com/product/images/xlarge/left/0002531700590\",\"size\":\"xlarge\"},{\"perspective\":\"left\",\"url\":\"https://www.kroger.com/product/images/large/left/0002531700590\",\"size\":\"large\"},{\"perspective\":\"left\",\"url\":\"https://www.kroger.com/product/images/medium/left/0002531700590\",\"size\":\"medium\"},{\"perspective\":\"left\",\"url\":\"https://www.kroger.com/product/images/small/left/0002531700590\",\"size\":\"small\"},{\"perspective\":\"left\",\"url\":\"https://www.kroger.com/product/images/thumbnail/left/0002531700590\",\"size\":\"thumbnail\"},{\"perspective\":\"top\",\"url\":\"https://www.kroger.com/product/images/xlarge/top/0002531700590\",\"size\":\"xlarge\"},{\"perspective\":\"top\",\"url\":\"https://www.kroger.com/product/images/large/top/0002531700590\",\"size\":\"large\"},{\"perspective\":\"top\",\"url\":\"https://www.kroger.com/product/images/medium/top/0002531700590\",\"size\":\"medium\"},{\"perspective\":\"top\",\"url\":\"https://www.kroger.com/product/images/small/top/0002531700590\",\"size\":\"small\"},{\"perspective\":\"top\",\"url\":\"https://www.kroger.com/product/images/thumbnail/top/0002531700590\",\"size\":\"thumbnail\"}],\"itemTypeCode\":\"0\",\"krogerDeliveryItem\":false,\"mainImagePerspective\":\"front\",\"nutritionalClaims\":[\"Low Fat\",\"No Artificial Ingredients\"],\"privacyRestricted\":false,\"privacyRestrictedStates\":[],\"prop65\":{\"required\":false},\"prop65Info\":{\"required\":false},\"ratingsAndReviewsAggregate\":{\"averageRating\":4.34,\"numOfFiveStarRating\":77,\"numOfFourStarRating\":11,\"numOfOneStarRating\":9,\"numOfThreeStarRating\":6,\"numOfTwoStarRating\":4,\"numberOfReviews\":107},\"romanceDescription\":\"<p>Hearty smoking brings a classic German tradition to your sandwich in Applegate Natural Uncured Black Forest Ham. Sliced and slow smoked to perfection, this ham is ready for your sandwich. It's fully cooked deli ham sandwich meat and ready to eat. It's the perfect lunch meat or cold cut. We source from farms, where animals are raised with care and respect. We believe this leads to great tasting products and peace of mind— all part of our mission. Changing The Meat We Eat. Fully cooked. Reseal for freshness.  </p><p>&nbsp;</p><p>Gluten &amp; casein free. Applegate humanely raised (Pork raised with no crates ever on vegetarian feed with no added hormones or growth promotants.). No nitrates or nitrites added (Except those naturally occurring in sea salt &amp; cultured celery powder). Pork raised with no antibiotics ever (Pork never administered antibiotics or fed animal by-products). Naturals (Minimally processed. No artificial ingredients).</p><ul><li>Applegate, Natural Uncured Black Forest Ham Sliced, 7oz</li><li>No Antibiotics or Added Hormones</li><li>No Chemical Nitrites or Nitrates</li><li>No Artificial or GMO Ingredients</li><li>Humanely Raised</li><li>Gluten Free</li><li>Dairy Free &amp; Casein Free</li></ul>\",\"salesChannelCode\":\"STORE\",\"salesChannelName\":\"Store\",\"seoDescription\":\"applegate-natural-sliced-uncured-black-forest-ham\",\"shareLink\":\"https://www.kroger.com/p/applegate-natural-sliced-uncured-black-forest-ham/0002531700590\",\"snapEligible\":true,\"soldInStore\":true,\"taxGroupCode\":\"PF050001\",\"taxonomies\":[{\"commodity\":{\"code\":\"013\",\"name\":\"Lunchmeat & Packaged Deli Meat\"},\"department\":{\"code\":\"05\",\"name\":\"Meat & Seafood\"},\"subCommodity\":{\"code\":\"00005\",\"name\":\"Packaged Ham\"}},{\"commodity\":{\"code\":\"003\",\"name\":\"Packaged Deli Meat & Lunchmeat\"},\"department\":{\"code\":\"13\",\"name\":\"Deli\"},\"subCommodity\":{\"code\":\"00002\",\"name\":\"Packaged Ham\"}}],\"temperatureIndicator\":\"55688103655\",\"upc\":\"0002531700590\",\"verified\":true,\"weight\":\"0.44 [lb_av]\"},\"location\":{\"locations\":[{\"aisle\":{\"description\":\"MEAT\",\"number\":\"101\",\"side\":\"R\"},\"bayInAisle\":\"25\",\"numOfFacings\":\"1\",\"physicalShelfNumber\":\"7\",\"shelfPositionInBay\":\"4\"}]},\"price\":{\"displayTemplate\":\"WhiteTag\",\"orderBy\":\"Unit\",\"sellBy\":\"Unit\",\"storePrices\":{\"regular\":{\"defaultDescription\":\"$7.79\",\"expirationDate\":{\"value\":\"9999-12-31T00:00:00Z\",\"timezone\":\"UTC\"},\"nfor\":1,\"nforPrice\":\"USD 7.79\",\"unitPrice\":\"USD 7.79\",\"price\":\"USD 7.79\",\"equivalizedUnitPrice\":{\"amount\":\"1.11\",\"denomination\":\"DOLLAR\",\"unit\":\"PER OUNCE\"},\"equivalizedUnitPriceString\":\"$1.11/oz\"},\"sourceLocationId\":\"03500577\",\"sellerId\":\"KR001\",\"sellerName\":\"Kroger\"}},\"nutrition\":{\"allergens\":\"Not intentionally nor inherently included Wheat and Their Derivatives,Soybean and its Derivatives,Milk and its derivates. Free from Sesame Seeds and their derivates,Crustaceans and their derivates,Eggs and their derivates,Fish and their derivates,Tree Nuts and Their Derivatives,Peanuts and their derivates.\",\"components\":[{\"footers\":[],\"headers\":[],\"footnotes\":[],\"preparationStates\":[{\"description\":\"Unspecified\",\"nutriFacts\":[{\"abbreviation\":\"g\",\"dailyValue\":\"0\",\"name\":\"Total Carbohydrate\",\"value\":\"1\"},{\"abbreviation\":\"mg\",\"dailyValue\":\"4\",\"name\":\"Potassium\",\"value\":\"192\"},{\"abbreviation\":\"mg\",\"dailyValue\":\"0\",\"name\":\"Calcium\",\"value\":\"5\"},{\"abbreviation\":\"kcal\",\"dailyValue\":\"0\",\"name\":\"Calories\",\"value\":\"70\"},{\"abbreviation\":\"mg\",\"dailyValue\":\"10\",\"name\":\"Cholesterol\",\"value\":\