"url\":\"https://www.kroger.com/product/images/medium/top/0001111097724\",\"size\":\"medium\"},{\"perspective\":\"top\",\"url\":\"https://www.kroger.com/product/images/small/top/0001111097724\",\"size\":\"small\"},{\"perspective\":\"top\",\"url\":\"https://www.kroger.com/product/images/thumbnail/top/0001111097724\",\"size\":\"thumbnail\"}],\"itemTypeCode\":\"0\",\"krogerDeliveryItem\":false,\"mainImagePerspective\":\"front\",\"privacyRestricted\":false,\"privacyRestrictedStates\":[],\"prop65\":{\"required\":false},\"prop65Info\":{\"required\":false},\"ratingsAndReviewsAggregate\":{\"averageRating\":2.17,\"numOfFiveStarRating\":1,\"numOfFourStarRating\":0,\"numOfOneStarRating\":2,\"numOfThreeStarRating\":0,\"numOfTwoStarRating\":3,\"numberOfReviews\":6},\"romanceDescription\":\"<p>Kroger® Black Forest Ham Uncured Deli Thin Sliced packs a flavor punch for simple, tasty meals, every time. Enjoy this gluten free and 97% fat free ham for worry-free meals. Deli thin sliced, it's great in sandwiches, salads, or chopped as a pizza topper. With no nitrates or nitrites added◊, you're getting delicious, fully cooked deli ham. Enjoy this family sized pack for days!</p><p>◊Except those naturally occurring in celery powder and sea salt.</p><p>Kroger® products are tried, tested and loved by you - quality guaranteed.</p><ul><li>9 oz Tub of Kroger® Black Forest Ham Uncured Deli Thin Sliced</li><li>Enjoy the 97% fat free pre-cooked, ham goodness in every slice</li><li>An easy addition to lunchtime meals or as a protein-rich snack</li><li>In a resealable tub to help maintain freshness of this ham lunch meat</li><li>Kroger® quality you can trust</li></ul>\",\"salesChannelCode\":\"STORE\",\"salesChannelName\":\"Store\",\"seoDescription\":\"kroger-black-forest-ham-uncured-deli-thin-sliced\",\"shareLink\":\"https://www.kroger.com/p/kroger-black-forest-ham-uncured-deli-thin-sliced/0001111097724\",\"snapEligible\":true,\"soldInStore\":true,\"tareValue\":0,\"taxGroupCode\":\"PF050001\",\"taxonomies\":[{\"commodity\":{\"code\":\"013\",\"name\":\"Lunchmeat & Packaged Deli Meat\"},\"department\":{\"code\":\"05\",\"name\":\"Meat & Seafood\"},\"subCommodity\":{\"code\":\"00005\",\"name\":\"Packaged Ham\"}}],\"temperatureIndicator\":\"55688103655\",\"upc\":\"0001111097724\",\"verified\":true,\"weight\":\"0.56 [lb_av]\"},\"location\":{\"locations\":[{\"aisle\":{\"description\":\"MEAT\",\"number\":\"101\",\"side\":\"R\"},\"bayInAisle\":\"26\",\"numOfFacings\":\"1\",\"physicalShelfNumber\":\"5\",\"shelfPositionInBay\":\"4\"}]},\"price\":{\"displayTemplate\":\"EveryDayLowPrice\",\"orderBy\":\"Unit\",\"sellBy\":\"Unit\",\"storePrices\":{\"regular\":{\"defaultDescription\":\"$3.99\",\"expirationDate\":{\"value\":\"9999-12-31T00:00:00Z\",\"timezone\":\"UTC\"},\"nfor\":1,\"nforPrice\":\"USD 3.99\",\"unitPrice\":\"USD 3.99\",\"price\":\"USD 3.99\",\"equivalizedUnitPrice\":{\"amount\":\"44.33\",\"denomination\":\"CENT\",\"unit\":\"PER OUNCE\"},\"equivalizedUnitPriceString\":\"$0.44/oz\"},\"sourceLocationId\":\"03500577\",\"sellerId\":\"KR001\",\"sellerName\":\"Kroger\"}},\"nutrition\":{\"allergens\":\"Free from Does Not Contain Declaration Obligatory Allergens.\",\"components\":[{\"footers\":[],\"headers\":[],\"footnotes\":[],\"preparationStates\":[{\"description\":\"Ready to Eat\",\"nutriFacts\":[{\"abbreviation\":\"g\",\"dailyValue\":\"0\",\"precision\":\"Approximately\",\"name\":\"Total Carbohydrate\",\"value\":\"1\"},{\"abbreviation\":\"g\",\"dailyValue\":\"0\",\"precision\":\"Approximately\",\"name\":\"Dietary Fiber\",\"value\":\"0\"},{\"abbreviation\":\"mg\",\"dailyValue\":\"2\",\"precision\":\"Approximately\",\"name\":\"Calcium\",\"value\":\"0\"},{\"abbreviation\":\"g\",\"dailyValue\":\"0\",\"precision\":\"Approximately\",\"name\":\"Trans Fat\",\"value\":\"0\"},{\"abbreviation\":\"cal\",\"dailyValue\":\"0\",\"precision\":\"Approximately\",\"name\":\"Calories from Fat\",\"value\":\"15\"},{\"abbreviation\":\"g\",\"dailyValue\":\"5\",\"precision\":\"Approximately\