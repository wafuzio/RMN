xt a#metromarket{  \\n\\ndisplay:inline;  \\n\\n}  \\n\\nbody[data-banner=\\\"pay-less\\\"] #onetrust-policy-text a#pay-less{  \\n\\ndisplay:inline;  \\n\\n}  \\n\\nbody[data-banner=\\\"picknsave\\\"] #onetrust-policy-text a#picknsave{  \\n\\ndisplay:inline;  \\n\\n}  \\n\\nbody[data-banner=\\\"qfc\\\"] #onetrust-policy-text a#qfc{  \\n\\ndisplay:inline;  \\n\\n}  \\n\\nbody[data-banner=\\\"ralphs\\\"] #onetrust-policy-text a#ralphs{  \\n\\ndisplay:inline;  \\n\\n}  \\n\\nbody[data-banner=\\\"smithsfoodanddrug\\\"] #onetrust-policy-text a#smithsfoodanddrug{  \\n\\ndisplay:inline;  \\n\\n}  \\n\\n#onetrust-banner-sdk :not(.ot-leg-btn-container)>button:focus {\\noutline: none;\\n}\\n#onetrust-accept-btn-handler {border-radius: 20px ! important;}\\n\\nh3#onetrust-policy-title {\\n    background: no-repeat left 9px url(https://www.vitacost.com/images/info.svg) !important;\\n    width: 270px !important;\\n    padding-left: 33px !important;\\n    height: 30px !important;\\n    background-size: 8% !important;\\n    padding-top: 8px !important;\\n}\\n\\n@media only screen and (min-width: 1024px){\\n#onetrust-banner-sdk #onetrust-close-btn-container {\\n    top: 20% !important;\\n}\\n}\",\"PCCustomCSS\":\"/*  ***************************** KROGER BANNER CSS -- VA  ***************************** */\\n/* BANNER: Hide all anchor tags within Overview at Outset */\\nbody[data-banner] #ot-tab-desc a{ \\n\\ndisplay:none; \\n\\nfont-weight:800; \\n\\ncolor:#4471b7!important; \\n\\nmargin: unset; \\n\\npadding-left:0 !important; \\n\\nmargin-right:0 !important; \\n\\n} \\n\\n/* BANNER: Using the same IDs for 2 anchor tags per banner. This places a period after ONLY the first one per banner */ \\n\\n#ot-tab-desc a: nth-child(2)::after{ \\n\\ncontent:'.'; \\n\\n} \\n\\n/* BANNER: This shows the appropriate links based on the data-banner element in the body tag */ \\nbody[data-banner=\\\"irkroger\\\"] #ot-tab-desc a#irkroger{display:inline;} \\nbody[data-banner=\\\"bakersplus\\\"] #ot-tab-desc a#bakersplus{display:inline;} \\nbody[data-banner=\\\"citymarket\\\"] #ot-tab-desc a#citymarket{display:inline;} \\nbody[data-banner=\\\"dillons\\\"] #ot-tab-desc a#dillons{display:inline;} \\nbody[data-banner=\\\"food4less\\\"] #ot-tab-desc a#food4less{display:inline;} \\nbody[data-banner=\\\"foodsco\\\"] #ot-tab-desc a#foodsco{display:inline;} \\nbody[data-banner=\\\"fredmeyer\\\"] #ot-tab-desc a#fredmeyer{display:inline;} \\nbody[data-banner=\\\"frysfood\\\"] #ot-tab-desc a#frysfood{display:inline;} \\nbody[data-banner=\\\"gerbes\\\"] #ot-tab-desc a#gerbes{display:inline;} \\nbody[data-banner=\\\"jaycfoods\\\"] #ot-tab-desc a#jaycfoods{display:inline;} \\nbody[data-banner=\\\"kingsoopers\\\"] #ot-tab-desc a#kingsoopers{display:inline;} \\nbody[data-banner=\\\"kroger\\\"] #ot-tab-desc a#kroger{display:inline;} \\nbody[data-banner=\\\"marianos\\\"] #ot-tab-desc a#marianos{display:inline;} \\nbody[data-banner=\\\"metromarket\\\"] #ot-tab-desc a#metromarket{display:inline;} \\nbody[data-banner=\\\"pay-less\\\"] #ot-tab-desc a#pay-less{display:inline;} \\nbody[data-banner=\\\"picknsave\\\"] #ot-tab-desc a#picknsave{display:inline;} \\nbody[data-banner=\\\"qfc\\\"] #ot-tab-desc a#qfc{display:inline;} \\nbody[data-banner=\\\"ralphs\\\"] #ot-tab-desc a#ralphs{display:inline;} \\nbody[data-banner=\\\"smithsfoodanddrug\\\"] #ot-tab-desc a#smithsfoodanddrug{display:inline;} \\n\\n\\n/* link style reference:\\nstyle=\\\"font-weight:800;color:#4471b7!important;margin: unset; padding-left:0 !important;margin-right:0 !important;\\\"\\n*/\\n\\n/* This hides the Title and toggle for the 3rd and 4th tabs that don’t enable Opt-Outs */\\n\\n#onetrust-pc-sdk .ot-desc-cntr:nth-child(3) .ot-grp-hdr1,\\n#onetrust-pc-sdk .ot-desc-cntr:nth-child(4) .ot-grp-hdr1,\\n#onetrust-pc-sdk .ot-desc-cntr:nth-child(5) .ot-grp-hdr1{\\ndisplay:none;\\n}\\n\\n/* This hides the Title of the Overview tab */\\n#onetrust-consent-sdk #onetrust-pc-sdk h4{\\ndisplay:none;\\n}\\n\\n/* This hides the Title for the 2nd tab (Targeted advertising) but leaves the master toggle visible. This allows us to hide the individual subcategories within Sale of Data */\\n#onetrust-pc-sdk .ot-desc-cntr:nth-child(2) .ot-grp-hdr1 h4 {\\ndisplay:none;\\n}\\n\\n#onetrust-pc-sdk .ot-grp-desc a {\\n    font-weight: 700;\\n    color: #4471b7;\\n    text-decoration: none;\\n    background-color: transparent;\\n    border: 0;\\n    box-sizing: border-box;\\n    margin: 0;\\n    padding: 0;\\n}\\n\\n/* Constructors for Slider */\\n\\n/* Sider Status Label */\\n#onetrust-pc-sdk .ot-label-status {\\n    font-size: 1em;\\n    font-weight: bold;\\n    position: relative;\\n    top: 2px;\\n    display: none;\\n    padding-right: 5px;\\n    float: left;\\n}\\n\\n/* Slider Bar */\\n#onetrust-pc-sdk .ot-switch {\\n    FONT-WEIGHT: 100;\\n    position: relative;\\n    display: inline-block;\\n    width: 45px;\\n    height: 30px;\\n    margin-bottom: 0px;\\n}\\n\\n/*Slider Circle */\\n\\n#onetrust-pc-sdk .ot-switch-nob {\\n    position: absolute;\\n    cursor: pointer;\\n    top: 0;\\n    left: 0;\\n    right: 0;\\n    bottom: 0;\\n    background-color: #f2f1f1;\\n    border: none;\\n    transition: all .2s ease-in 0s;\\n    -moz-transition: all .2s ease-in 0s;\\n    -o-transition: all .2s ease-in 0s;\\n    -webkit-transition: all .2s ease-in 0s;\\n    border-radius: 45px;\\n}\\n\\n\\n#onetrust-pc-sdk .ot-switch-nob:before {\\n    position: absolute;\\n    content: \\\"\\\";\\n    height: 30px;\\n    width: 30px;\\n    bottom: 1px;\\n    background-color: #7d7d7d;\\n    -webkit-transition: .4s;\\n    border-radius: 100%;\\n    top: 0px;\\n    transition: .4s;\\n}\\n\\n/* Raises Opt-Out of Sale title to the top, adjusts Slider position */\\n/* Position the title and toggle: */\\n\\n#onetrust-pc-sdk .ot-grp-hdr1 {\\n    padding-left: unset;\\n    width: unset;\\n    padding-top: 2px;\\n\\tpadding-right: 2px;\\n    margin-bottom: unset;\\n    padding-bottom: unset;\\n    position: absolute;\\n\\tright:0;\\n}\\n\\n#onetrust-pc-sdk .ot-desc-cntr {\\n    position: relative;\\n}\\n\\n/* Enables dynamic generation of Banner Logo based on loaded banner so templates can be shared across banners without using Branding Override, which would require all templates have the same structure/number of tabs, etc. This custom code approach was created by Heather Harkins, produced in cooperation with the Web Core team for 2023 Implementation. */\\n\\n/* Hide Default OT Image */\\n#onetrust-pc-sdk .ot-pc-logo.ot-pc-logo img {\\n\\tdisplay:none;\\n}\\n\\n/* Set params for Div of Logo Image */\\n#onetrust-pc-sdk .ot-pc-logo.ot-pc-logo {\\nbackground-size: contain;\\nbackground-repeat: no-repeat;\\n}\\n\\n/* Logos by Banner */\\nbody[data-banner=\\\"bakersplus\\\"]   #onetrust-pc-sdk .ot-pc-logo.ot-pc-logo {\\nbackground-image: url('https://www.kroger.com/content/v2/binary/image/bakers_svg_logo--freshcart_bakers_color_logo--bakers.svg');\\n}\\nbody[data-banner=\\\"citymarket\\\"]   #onetrust-pc-sdk .ot-pc-logo.ot-pc-logo {\\nbackground-image: url('https://www.kroger.com/content/v2/binary/image/citymarket_svg_logo--freshcart_citymarket_color_logo--citymarket.svg');\\n}\\nbody[data-banner=\\\"copps\\\"]   #onetrust-pc-sdk .ot-pc-logo.ot-pc-logo {\\nbackground-image: url('https://www.kroger.com/content/v2/binary/image/metromarket_svg_logo--freshcart_metromarket_color_logo--metromarket.svg');\\n}\\nbody[data-banner=\\\"dillons\\\"]   #onetrust-pc-sdk .ot-pc-logo.ot-pc-logo {\\nbackground-image: url('https://www.kroger.com/content/v2/binary/image/dillons_svg_logo--freshcart_dillons_color_logo--dillons.svg');\\n}\\nbody[data-banner=\\\"food4less\\\"]   #onetrust-pc-sdk .ot-pc-logo.ot-pc-logo {\\nbackground-image: url('https://www.kroger.com/content/v2/binary/image/food4less_svg_logo-desktop-1556238406166.svg');\\n}\\nbody[data-banner=\\\"foodsco\\\"]   #onetrust-pc-sdk .ot-pc-logo.ot-pc-logo {\\nbackground-image: url('https://www.kroger.com/content/v2/binary/image/foodsco_svg_logo-desktop-15