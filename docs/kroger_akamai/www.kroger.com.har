            "text": "{\"schema\":{\"name\":\"keymessage_list\",\"version\":\"1.0.0\"},\"meta\":{\"name\":\"key-messages_boars-head-geo_03-05-26\",\"versionKey\":3},\"data\":{\"keyMessages\":[{\"schema\":{\"name\":\"keymessage\",\"version\":\"1.0.0\"},\"data\":{\"webRoutes\":[\"/health\"],\"content\":[{\"schema\":{\"name\":\"keymessage_ui\",\"version\":\"1.0.0\"},\"data\":{\"headerTag\":\"span\",\"isExternalLink\":false,\"isInverseText\":false,\"header\":\"New oral GLP-1 medication now available for as low as $149/month.*\",\"ctaText\":\"Learn More\",\"ctaUrl\":\"/health/pharmacy/insurance-savings#GLP1\",\"backgroundColor\":\"#FED241\"},\"meta\":{\"name\":\"key-messages/glp1-savings_03-05-26\",\"versionKey\":2}}]},\"meta\":{\"name\":\"key-messages/glp1-savings_03-05-26\",\"versionKey\":2}},{\"schema\":{\"name\":\"keymessage\",\"version\":\"1.0.0\"},\"data\":{\"webRoutes\":[\"/\"],\"content\":[{\"schema\":{\"name\":\"keymessage_ui\",\"version\":\"1.0.0\"},\"data\":{\"headerTag\":\"span\",\"isExternalLink\":false,\"isInverseText\":false,\"header\":\"Get ready for daily deals during Customer Appreciation Week 3/11-3/17.\",\"ctaText\":\"Learn More\",\"ctaUrl\":\"/pr/customer-appreciation-week\",\"backgroundColor\":\"#EFF7FD\"},\"meta\":{\"name\":\"key-messages/caw-teaser_03-04-26\",\"versionKey\":4}}]},\"meta\":{\"name\":\"key-messages/caw-teaser_03-04-26\",\"versionKey\":2}},{\"schema\":{\"name\":\"keymessage\",\"version\":\"1.0.0\"},\"data\":{\"webRoutes\":[\"/f/weight-loss\"],\"content\":[{\"schema\":{\"name\":\"keymessage_ui\",\"version\":\"1.0.0\"},\"data\":{\"headerTag\":\"span\",\"isExternalLink\":false,\"isInverseText\":false,\"header\":\"Our pharmacists help you find lower prices and accept most discount cards for all your prescriptions, including those for weight loss.\",\"ctaText\":\"Learn More\",\"ctaUrl\":\"/health/pharmacy/insurance-savings\",\"backgroundColor\":\"#FED241\"},\"meta\":{\"name\":\"key-messages/glp-1-savings_03-04-26\",\"versionKey\":2}}]},\"meta\":{\"name\":\"key-messages/glp-1-savings_03-04-26\",\"versionKey\":2}},{\"schema\":{\"name\":\"keymessage\",\"version\":\"1.0.0\"},\"data\":{\"content\":[{\"schema\":{\"name\":\"keymessage_ui\",\"version\":\"1.0.0\"},\"data\":{\"headerTag\":\"span\",\"isExternalLink\":false,\"isInverseText\":false,\"header\":\"Boar's Head items are temporarily unavailable for Kroger Delivery.\",\"backgroundColor\":\"#FED141\",\"ctaText\":\"Shop Available Deli Meats\",\"ctaUrl\":\"/pl/fresh-deli-meats/13001\"},\"meta\":{\"name\":\"key-messages/boars-head-temp-unavailable_12-16\",\"versionKey\":2}}],\"webRoutes\":[\"/search?query=boar*\",\"/search?query=deli*\",\"/search?query=Turkey*\",\"/search?query=Ham*\",\"/d/deli\",\"/search?query=salami*\",\"/search?query=lunch%20meat&searchType=default_search\",\"/search?query=roast%20beef&searchType=default_search\"]},\"meta\":{\"name\":\"key-messages/boars-head-temp-unavailable_02-20-26\",\"versionKey\":3}},{\"schema\":{\"name\":\"keymessage\",\"version\":\"1.0.0\"},\"data\":{\"content\":[{\"schema\":{\"name\":\"keymessage_ui\",\"version\":\"1.0.0\"},\"data\":{\"headerTag\":\"span\",\"isExternalLink\":false,\"isInverseText\":false,\"header\":\"Boar's Head items are temporarily unavailable for Kroger Delivery.\",\"backgroundColor\":\"#FED141\",\"ctaText\":\"Shop Available Deli Cheeses\",\"ctaUrl\":\"/pl/fresh-deli-cheese/13002\"},\"meta\":{\"name\":\"key-messages/boars-head-temp-unavailable_cheese_12-16\",\"versionKey\":2}}],\"webRoutes\":[\"/search?query=american%20cheese&searchType=default_search\",\"/search?query=deli%20cheese&searchType=default_search\",\"/search?query=white%20american%20cheese&searchType=default_search\"]},\"meta\":{\"name\":\"key-messages/boars-head-temp-unavailable_cheese_12-16\",\"versionKey\":2}},{\"schema\":{\"name\":\"keymessage\",\"version\":\"1.0.0\"},\"data\":{\"content\":[{\"schema\":{\"name\":\"keymessage_ui\",\"version\":\"1.0.0\"},\"data\":{\"headerTag\":\"span\",\"isExternalLink\":false,\"isInverseText\":false,\"header\":\"By clicking on the external links, you’ll be leaving this site and will be subject to the privacy policy and terms & conditions of those external sites.\",\"backgroundColor\":\"#FED241\"},\"meta\":{\"name\":\"key-messages/kroger_play_external_links-06-02-25\",\"versionKey\":3}}],\"webRoutes\":[\"/o/kroger-play\",\"/o/kroger-play-faq\",\"/o/kroger-play-espnbet\",\"/o/kroger-play-ownersbox\",\"/o/kroger-play-pennplay\"]},\"meta\":{\"name\":\"key-messages/kroger_play_external_links-06-02-25\",\"versionKey\":3}},{\"schema\":{\"name\":\"keymessage\",\"version\":\"1.0.0\"},\"data\":{\"webRoutes\":[\"/krogerhealth\"],\"content\":[{\"schema\":{\"name\":\"keymessage_ui\",\"version\":\"1.0.0\"},\"data\":{\"headerTag\":\"span\",\"isExternalLink\":false,\"isInverseText\":false,\"header\":\"Keep your Team Healthy - Schedule Employee Vaccinations Today.\",\"ctaText\":\"Learn More\",\"ctaUrl\":\"/vaccines\",\"textColor\":\"#0F52A2\",\"backgroundColor\":\"#e4e7ea\"},\"meta\":{\"name\":\"key-messages/b2b-schedule-today\",\"versionKey\":2}}]},\"meta\":{\"name\":\"key-messages/kroger-health-b2b\",\"versionKey\":3}},{\"schema\":{\"name\":\"keymessage\",\"version\":\"1.0.0\"},\"data\":{\"webRoutes\":[\"/i/payment/snap-ebt-online-orders\"],\"content\":[{\"schema\":{\"name\":\"keymessage_ui\",\"version\":\"1.0.0\"},\"data\":{\"headerTag\":\"span\",\"isExternalLink\":false,\"isInverseText\":false,\"header\":\"Starting on January 1, 2026, Kroger will follow state-regulated updates that change the SNAP EBT product eligibility from national to state-level. Please contact your issuing state for additional guidance or information.\",\"backgroundColor\":\"#FED241\"},\"meta\":{\"name\":\"key-messages/snap-ebt\",\"versionKey\":2}}]},\"meta\":{\"name\":\"key-messages/snap-ebt\",\"versionKey\":3}}]}}"
